# openGym pass-through: every request under this folder goes to index.php, which forwards it to
# the openGym Node.js project. This file overrides WordPress's rules for this folder only.
DirectoryIndex index.php
Options -Indexes -MultiViews

# config.php (the secret) and any other PHP, config, backup or log file here can never be read or
# run from the web, even if it is added later; only index.php runs. Apache checks these names
# before the rewrite below, so the app's own paths (assets/..., api/...) are not affected: they
# are not files here and go to index.php, which only ever asks the Node.js project for them.
<FilesMatch "^(?!index\.php$).*\.(php\d?|phtml|phar|phps|inc|ini|env|bak|old|orig|save|swp|sample|dist|log|sql|sh|zip|tar|gz)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>
